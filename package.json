{
  "name": "wj-mcp-server",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.16.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:ui": "vite build",
    "dev": "vite build && tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npx @modelcontextprotocol/inspector@latest",
    "secrets": "node scripts/generate-secrets.mjs",
    "check": "tsc --noEmit && vitest run --config vitest.config.ts && vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "^16.6.1",
    "express": "5.2.1",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "lucide": "^0.468.0",
    "oidc-provider": "9.11.3",
    "p-limit": "^6.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "rate-limiter-flexible": "11.2.0",
    "redis": "^5.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/oidc-provider": "^8.8.1",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "supertest": "^7.1.4",
    "tsx": "4.23.11",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4"
  }
}
