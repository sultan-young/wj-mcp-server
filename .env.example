# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=6070
PUBLIC_BASE_URL=https://mcp.wj.zaowuwujie.ltd
TRUST_PROXY=true
ALLOWED_HOSTS=mcp.wj.zaowuwujie.ltd,127.0.0.1,localhost
LOG_LEVEL=info

# Existing WJ open-platform API. Keep this key only on the server.
WJ_API_BASE_URL=https://wj.zaowuwujie.ltd
WJ_IMAGE_PATH=/api/v1/proxy/ai/generate/image
WJ_API_KEY=
WJ_DEFAULT_MODEL=gpt-image-2
WJ_ALLOWED_MODELS=gpt-image-2,nano-banana-2
WJ_REQUEST_TIMEOUT_MS=330000

# Shared OAuth access. Replace all three values before deployment.
MCP_SHARED_PASSWORD=change-me-before-deploy
OAUTH_COOKIE_KEYS=
OAUTH_JWKS=
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Redis persists OAuth clients/tokens and rate limits.
REDIS_URL=redis://redis:6379

# Cost controls for this no-team v1. Limits are global to the shared identity.
IMAGE_RATE_LIMIT_PER_MINUTE=5
IMAGE_DAILY_LIMIT=100
IMAGE_MAX_CONCURRENCY=2
LOGIN_ATTEMPTS_PER_15_MINUTES=10
REGISTRATIONS_PER_HOUR=20

# Add every HTTPS origin that may host returned image URLs.
IMAGE_RESOURCE_DOMAINS=https://img.downk.cc
